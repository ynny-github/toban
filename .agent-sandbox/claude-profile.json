{
  // nono's packaged profile for Claude Code, distributed as the
  // nolabs-ai/claude registry pack: run `nono pull nolabs-ai/claude` once
  // before launching (nono 0.78.0 no longer compiles a `claude` profile in).
  // Pulling it also wires the pack's `nono@nolabs-ai` plugin into
  // ~/.claude/settings.json. It is a strict allowlist -- measured: on its
  // own it forwards only PATH, BROWSER and NONO_CAP_FILE, not even HOME.
  "extends": "nolabs-ai/claude",
  "meta": { "name": "agent-sandbox agent (minimal)" },

  // The agent's file tools write scratch files and read them back. The floor
  // grants /tmp write-only, which fails on the read-back.
  //
  // A docker-based MCP server (added via `claude --mcp-config`) runs as a
  // direct child of the agent and works here unchanged: nono leaves unix
  // socket mediation off by default, so /var/run/docker.sock is reachable
  // without a grant. ~/.docker is only for registry credentials, and is not
  // what makes docker work.
  //
  // ~/.orca/agent-hooks: Orca's status hooks in ~/.claude/settings.json run
  // claude-hook.sh from here; unreadable, the hook silently does nothing.
  "filesystem": {
    "allow": ["/tmp"],
    "read": ["~/.orca/agent-hooks"]
  },

  // Network is deliberately NOT blocked here: Claude cannot reach its API
  // without it. The command side is what is confined.
  "environment": {
    "allow_vars": [
      "PATH", "HOME", "USER", "TERM", "LANG", "LC_ALL",

      // Load-bearing. Stripped, the agent never reaches execd and every
      // command fails with an error that names nothing.
      "AGENT_SANDBOX_EXECD_SOCKET",

      // Names the --norc bash wrapper the launcher generates. Stripped,
      // Claude falls back to the login shell, which sources ~/.bashrc, which
      // no profile grants -- every tool result is then prefixed with a
      // permission error. Costs noise, not access.
      "CLAUDE_CODE_SHELL",

      // Orca's status hooks POST these to Orca so its tab shows whether the
      // agent is working or waiting. Stripped, the hook exits without
      // posting. ORCA_AGENT_HOOK_TOKEN lets the agent post any status to
      // Orca's hook listener; it reaches nothing else.
      "ORCA_PANE_KEY", "ORCA_TAB_ID", "ORCA_WORKTREE_ID",
      "ORCA_AGENT_LAUNCH_TOKEN", "ORCA_AGENT_HOOK_PORT",
      "ORCA_AGENT_HOOK_TOKEN", "ORCA_AGENT_HOOK_ENV",
      "ORCA_AGENT_HOOK_VERSION", "ORCA_AGENT_HOOK_TRANSPORT",
      "ORCA_AGENT_HOOK_ENDPOINT"

      // Add "CONTEXT_MODE_EXEC_BACKEND" here to use `claude --context-mode`.
    ]
  }
}
